{
  "version": 2,
  "functions": {
    "api/slots.js": { "memory": 128, "maxDuration": 10 },
    "api/book.js":  { "memory": 128, "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
